# ─────────────────────────────────────────────────────────────────────────────
# B2B Lead Generation System — konfiguracija
# Kopirajte to datoteko kot .env in zapolnite vrednosti
# ─────────────────────────────────────────────────────────────────────────────

# ── SMTP rotacija (JSON array — do 5 računov za 3.000 emailov/dan) ───────────
# Vsak račun: max 500-1000 emailov/dan
# Priporočeno: Gmail App Password, SendGrid, Mailgun, AWS SES
SMTP_ACCOUNTS=[{"host":"smtp.gmail.com","port":587,"user":"account1@gmail.com","password":"app_pass1","name":"Ime Priimek","phone":"+386 XX XXX XXX","daily_limit":500},{"host":"smtp.gmail.com","port":587,"user":"account2@gmail.com","password":"app_pass2","name":"Ime Priimek","phone":"+386 XX XXX XXX","daily_limit":500}]

# ── IMAP (za zaznavanje odgovorov in follow-up) ───────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_USER=tvoj@email.com
IMAP_PASSWORD=app_password

# ── Privzeti pošiljatelj (če SMTP_ACCOUNTS ni nastavljen) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tvoj@email.com
SMTP_PASSWORD=app_password
SENDER_NAME=Ime Priimek
SENDER_PHONE=+386 XX XXX XXX

# ── Limiti pošiljanja ─────────────────────────────────────────────────────────
DAILY_EMAIL_LIMIT=3000
MIN_DELAY_SECONDS=10
MAX_DELAY_SECONDS=30

# ── Proxy rotacija (za EU scraping — preprečuje IP bane) ──────────────────────
# Format: socks5://user:pass@host:port ali http://user:pass@host:port
# Ločene z vejico. Prazno = direktna povezava (samo za testiranje)
PROXY_LIST=

# ── Scraping nastavitve ───────────────────────────────────────────────────────
SCRAPE_DELAY_MIN=1
SCRAPE_DELAY_MAX=3
SCRAPE_CONCURRENCY=10
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ── API ključi ────────────────────────────────────────────────────────────────
# SerpAPI za Google Maps scraping (https://serpapi.com)
SERPAPI_KEY=

# ── Sledenje (tracking pixel) ─────────────────────────────────────────────────
# URL vaše domene za tracking odpiranj emailov
TRACKING_BASE_URL=

# ── Baza podatkov ─────────────────────────────────────────────────────────────
DATABASE_PATH=data/leads.db
# Za PostgreSQL v produkciji:
# DATABASE_URL=postgresql://user:password@localhost:5432/leads_db

# ── Preview generator ─────────────────────────────────────────────────────────
# URL kjer so dostopne generirane preview strani
PREVIEW_BASE_URL=http://localhost:8080/previews

# ── Razpored (scheduler) ──────────────────────────────────────────────────────
# Čas dnevnega zagona (HH:MM, pon-pet)
DAILY_RUN_TIME=08:00
